# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# SHARED FIREBASE PROJECT CONFIGURATION (swas-tasks-control-centre)
# Both SWAS TASKS Client Website & SWAS TASKS Central Control Centre connect
# to the exact same Firebase project: swas-tasks-control-centre.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=swas-tasks-control-centre.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=swas-tasks-control-centre
VITE_FIREBASE_STORAGE_BUCKET=swas-tasks-control-centre.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=(default)

# Server-side Firebase Admin SDK target (uses ADC on GCP/Cloud Run or service account credentials)
FIREBASE_PROJECT_ID=swas-tasks-control-centre
FIREBASE_DATABASE_ID=(default)
# Optional: JSON string of Firebase service account credentials when deploying outside GCP (e.g. Vercel)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional comma-separated extra Super Admin emails (default: lovewaithaka8@gmail.com)
SUPER_ADMIN_EMAILS=lovewaithaka8@gmail.com

# Secret header (x-cron-secret) protecting scheduled /api/cron/process-timers endpoint (e.g. Vercel Cron)
CRON_SECRET=

# Backend Email Delivery Configuration (SWAS TASKS Official Sender: swastaskorg@gmail.com)
# Configure these in Settings -> Secrets or server environment variables. Never expose in frontend code.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Financial Institutions & Payout Providers (Server-side only — never expose in client bundles)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
EXCHANGE_RATE_API_KEY=
