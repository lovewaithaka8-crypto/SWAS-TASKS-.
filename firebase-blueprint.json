{
  "entities": {
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private user account, role, preferences, and contact details isolated to the owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified account email."
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Full name or display name."
        },
        "role": {
          "type": "string",
          "enum": ["worker", "client"],
          "description": "Immutable account role assigned at registration."
        },
        "phone": {
          "type": "string",
          "maxLength": 24,
          "description": "Private phone or M-Pesa number."
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional avatar URL."
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "description": "Short worker or client bio."
        },
        "skills": {
          "type": "array",
          "description": "Worker skills list (bounded to max 10 items)."
        },
        "businessName": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional client business name."
        },
        "businessIndustry": {
          "type": "string",
          "maxLength": 80,
          "description": "Optional client business industry."
        },
        "country": {
          "type": "string",
          "maxLength": 12,
          "description": "ISO country code used to filter financial institutions."
        },
        "preferredCurrency": {
          "type": "string",
          "maxLength": 8,
          "description": "Preferred wallet display currency code."
        },
        "notifyBids": {
          "type": "boolean",
          "description": "Preference for bid notifications."
        },
        "notifyMessages": {
          "type": "boolean",
          "description": "Preference for message notifications."
        },
        "notifyPayments": {
          "type": "boolean",
          "description": "Preference for payment notifications."
        },
        "publicProfileVisible": {
          "type": "boolean",
          "description": "Privacy toggle for public profile visibility."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Non-PII public profile visible to marketplace participants.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["worker", "client"]
        },
        "bio": {
          "type": "string",
          "maxLength": 500
        },
        "skills": {
          "type": "array"
        },
        "businessName": {
          "type": "string",
          "maxLength": 100
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "createdAt", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "Task posted by a client with KES budget, skills, deadline, and visibility.",
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 15,
          "maxLength": 2000
        },
        "category": {
          "type": "string",
          "enum": [
            "Data & Research",
            "Content & Copywriting",
            "Design & Media",
            "QA & Testing",
            "Field & Errands",
            "Web & Technical"
          ]
        },
        "skills": {
          "type": "array"
        },
        "budgetKes": {
          "type": "number"
        },
        "deadline": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "attachmentUrl": {
          "type": "string",
          "maxLength": 400
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "invite_only"]
        },
        "status": {
          "type": "string",
          "enum": ["open", "paused", "in_progress", "completed", "closed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "clientId",
        "clientName",
        "title",
        "description",
        "category",
        "budgetKes",
        "deadline",
        "visibility",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Bid": {
      "title": "Bid",
      "description": "Worker bid proposal against an open task.",
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "taskTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "workerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "amountKes": {
          "type": "number"
        },
        "deliveryDays": {
          "type": "number"
        },
        "proposal": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1500
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "rejected", "withdrawn"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "taskId",
        "taskTitle",
        "clientId",
        "clientName",
        "workerId",
        "workerName",
        "amountKes",
        "deliveryDays",
        "proposal",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Assignment": {
      "title": "Assignment",
